---
// src/components/PortableText.astro
// Component to render Sanity Portable Text content
interface Props {
  value: any[];
}

const { value } = Astro.props;

const esc = (s: string) =>
  String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

function renderBlock(block: any): string {
  if (!block) return '';

  switch (block._type) {
    case 'block':
      return renderBlockContent(block);
    case 'image':
      return `<img src="${esc(block.asset?.url || '')}" alt="${esc(block.alt || '')}" />`;
    default:
      return '';
  }
}

function renderBlockContent(block: any): string {
  const style = block.style || 'normal';
  const children = renderChildren(block.children || [], block.markDefs || []);

  switch (style) {
    case 'h1':
      return `<h1>${children}</h1>`;
    case 'h2':
      return `<h2>${children}</h2>`;
    case 'h3':
      return `<h3>${children}</h3>`;
    case 'h4':
      return `<h4>${children}</h4>`;
    case 'blockquote':
      return `<blockquote>${children}</blockquote>`;
    case 'motto':
      return `<p class="motto">${children}</p>`;
    case 'normal':
    default:
      return `<p>${children}</p>`;
  }
}

function renderChildren(children: any[], markDefs: any[]): string {
  return children.map(child => {
    if (child._type === 'span') {
      let text = esc(child.text || '');

      // Apply marks
      if (child.marks && child.marks.length > 0) {
        child.marks.forEach((mark: string) => {
          switch (mark) {
            case 'strong':
              text = `<strong>${text}</strong>`;
              break;
            case 'em':
              text = `<em>${text}</em>`;
              break;
            case 'code':
              text = `<code>${text}</code>`;
              break;
            case 'underline':
              text = `<u>${text}</u>`;
              break;
            default: {
              const def = markDefs.find((d: any) => d._key === mark);
              if (def?._type === 'link' && /^(https?:|mailto:)/.test(def.href || '')) {
                const external = /^https?:/.test(def.href) && !def.href.includes('25collectiveco.com');
                text = `<a href="${esc(def.href)}"${external ? ' target="_blank" rel="noopener noreferrer"' : ''}>${text}</a>`;
              }
            }
          }
        });
      }

      return text;
    }
    return '';
  }).join('');
}

// Consecutive list items become one <ul>/<ol>.
function renderAll(blocks: any[]): string {
  const out: string[] = [];
  let list: { tag: string; items: string[] } | null = null;
  const close = () => { if (list) { out.push(`<${list.tag}>${list.items.join('')}</${list.tag}>`); list = null; } };
  for (const b of blocks || []) {
    if (b?._type === 'block' && b.listItem) {
      const tag = b.listItem === 'number' ? 'ol' : 'ul';
      if (!list || list.tag !== tag) { close(); list = { tag, items: [] }; }
      list.items.push(`<li>${renderChildren(b.children || [], b.markDefs || [])}</li>`);
    } else { close(); out.push(renderBlock(b)); }
  }
  close();
  return out.join('\n');
}

const html = renderAll(value);
---

<Fragment set:html={html} />
